# LLM Visibility Study Configuration
# Copy to config.yaml and fill in your API keys

study:
  name: "LLM Brand Visibility — Supplement Market DE"
  version: "1.0.0"
  author: "Your Name"
  date: "2026-04-03"

models:
  claude:
    provider: "anthropic"
    model_id: "claude-sonnet-4-20250514"
    temperature: 0.7
    max_tokens: 2048
    api_key_env: "ANTHROPIC_API_KEY"
  gpt:
    provider: "openai"
    model_id: "gpt-4o"
    temperature: 0.7
    max_tokens: 2048
    api_key_env: "OPENAI_API_KEY"
  gemini:
    provider: "google"
    model_id: "gemini-1.5-pro"
    temperature: 0.7
    max_tokens: 2048
    api_key_env: "GOOGLE_API_KEY"

brands:
  - name: "AG1"
    domain: "drinkag1.com"
    aliases: ["ag1", "athletic greens", "AG1 by Athletic Greens"]
    category: "greens"
  - name: "Foodspring"
    domain: "foodspring.de"
    aliases: ["foodspring", "food spring"]
    category: "sports_nutrition"
  - name: "ESN"
    domain: "esn.com"
    aliases: ["esn", "elite sports nutrients", "ESN Designer Whey"]
    category: "sports_nutrition"
  - name: "Gloryfeel"
    domain: "gloryfeel.de"
    aliases: ["gloryfeel", "glory feel"]
    category: "vitamins"
  - name: "Naturtreu"
    domain: "naturtreu.de"
    aliases: ["naturtreu", "natur treu"]
    category: "natural"
  - name: "Glow25"
    domain: "glow25.de"
    aliases: ["glow25", "glow 25"]
    category: "collagen"
  - name: "Natural Mojo"
    domain: "naturalmojo.de"
    aliases: ["natural mojo", "naturalmojo"]
    category: "superfoods"
  - name: "Innonature"
    domain: "innonature.eu"
    aliases: ["innonature", "inno nature"]
    category: "organic"
  - name: "YFood"
    domain: "yfood.de"
    aliases: ["yfood", "y food"]
    category: "meal_replacement"
  - name: "Braineffect"
    domain: "brain-effect.com"
    aliases: ["braineffect", "brain effect", "BRAINEFFECT"]
    category: "nootropics"

prompt_clusters:
  - informational
  - commercial
  - navigational
  - comparison

runs:
  default: 30
  power_analysis: [10, 20, 30]

analysis:
  alpha: 0.05
  bootstrap_n: 5000
  multiple_testing_correction: "fdr_bh"
  random_seed: 42

visibility_scoring:
  position_1: 10
  position_2: 8
  position_3: 6
  position_4: 5
  position_5: 4
  mentioned_other: 2
  not_mentioned: 0

output:
  data_dir: "data"
  results_dir: "results"
  figures_dir: "results/figures"
